From add9c95f7511cf218364904ccabf25eab05bbd3a Mon Sep 17 00:00:00 2001
From: FengXiao <141389622+FengXiao1231@users.noreply.github.com>
Date: Mon, 19 Oct 2026 21:44:47 +0000
Subject: [PATCH] Keep index-format arrays from the URL when stringifyUrl
 merges the query

stringifyUrl parses the query already in the URL with sort: false, and in
that branch parse() returned index-format arrays (a[0]=x&a[1]=y) as a plain
object {0: 'x', 1: 'y'} instead of an array, so stringify() printed
a=[object Object]. Convert such objects to arrays in the unsorted branch as
the sorted branch already does.
---
 base.js               | 6 ++++++
 test/stringify-url.js | 5 +++++
 2 files changed, 11 insertions(+)

diff --git a/base.js b/base.js
index 6fc590a..ee22055 100644
--- a/base.js
+++ b/base.js
@@ -447,6 +447,12 @@ export function parse(query, options) {
 	}
 
 	if (options.sort === false) {
+		for (const [key, value] of Object.entries(returnValue)) {
+			if (Boolean(value) && typeof value === 'object' && !Array.isArray(value)) {
+				returnValue[key] = keysSorter(value);
+			}
+		}
+
 		return returnValue;
 	}
 
diff --git a/test/stringify-url.js b/test/stringify-url.js
index 16cb4ec..cf5d2ab 100644
--- a/test/stringify-url.js
+++ b/test/stringify-url.js
@@ -70,6 +70,11 @@ test('stringify URL without sorting existing query params', t => {
 	t.is(queryString.stringifyUrl({url: 'https://foo.bar?C=3&A=1', query: {D: 4, B: 2}}, {sort: false}), 'https://foo.bar?C=3&A=1&D=4&B=2');
 });
 
+test('stringify URL keeps an existing index-format array in the query', t => {
+	t.is(queryString.stringifyUrl({url: 'https://foo.bar?a[0]=x&a[1]=y', query: {}}, {arrayFormat: 'index', encode: false}), 'https://foo.bar?a[0]=x&a[1]=y');
+	t.is(queryString.stringifyUrl({url: 'https://foo.bar?a[1]=y&a[0]=x', query: {b: 1}}, {arrayFormat: 'index', encode: false}), 'https://foo.bar?a[0]=x&a[1]=y&b=1');
+});
+
 test('stringifyUrl uses parsing options when parsing existing query from url', t => {
 	const currentUrl = 'https://localhost:3000/?array[]=item1';
 
