From fcaa2f89b3a9cd3ac0f63b5b7741fe041c7e9cf3 Mon Sep 17 00:00:00 2001
From: FengXiao <141389622+FengXiao1231@users.noreply.github.com>
Date: Mon, 19 Oct 2026 21:46:13 +0000
Subject: [PATCH] Keep an escaped trailing space in a selector when trimming
 the query

QueryParser trimmed ASCII whitespace from both ends of the query before
tokenizing, which also removed a trailing space that is escaped with a
backslash and so is part of an identifier. The query that
escapeCssIdentifier("a ") produces, "#a\\ ", therefore matched nothing.
Trim as before, but stop at trailing whitespace preceded by an odd number
of backslashes.
---
 src/main/java/org/jsoup/select/QueryParser.java | 16 +++++++++++++++-
 .../java/org/jsoup/select/SelectorTest.java     | 17 +++++++++++++++++
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/src/main/java/org/jsoup/select/QueryParser.java b/src/main/java/org/jsoup/select/QueryParser.java
index b791474..0c08e6c 100644
--- a/src/main/java/org/jsoup/select/QueryParser.java
+++ b/src/main/java/org/jsoup/select/QueryParser.java
@@ -22,6 +22,7 @@ import java.util.regex.Matcher;
 import java.util.regex.Pattern;
 
 import static org.jsoup.internal.Normalizer.asciiLowerCase;
+import static org.jsoup.internal.StringUtil.isWhitespace;
 import static org.jsoup.internal.StringUtil.trimAsciiWhitespace;
 import static org.jsoup.select.StructuralEvaluator.ImmediateParentRun;
 
@@ -43,11 +44,24 @@ public class QueryParser implements AutoCloseable {
      */
     private QueryParser(String query) {
         Validate.notEmpty(query);
-        query = trimAsciiWhitespace(query);
+        query = trimQuery(query);
         this.query = query;
         this.tq = new TokenQueue(query);
     }
 
+    // Trims ASCII whitespace, but keeps trailing whitespace that is escaped by a backslash (part of an identifier).
+    private static String trimQuery(String query) {
+        int start = 0, end = query.length();
+        while (start < end && isWhitespace(query.charAt(start))) start++;
+        while (end > start && isWhitespace(query.charAt(end - 1))) {
+            int slashes = 0;
+            for (int i = end - 2; i >= start && query.charAt(i) == '\\'; i--) slashes++;
+            if (slashes % 2 == 1) break; // escaped whitespace
+            end--;
+        }
+        return query.substring(start, end);
+    }
+
     /**
      Parse a CSS query into an Evaluator. If you are evaluating the same query repeatedly, it may be more efficient to
      parse it once and reuse the Evaluator.
diff --git a/src/test/java/org/jsoup/select/SelectorTest.java b/src/test/java/org/jsoup/select/SelectorTest.java
index 5dd195e..186930e 100644
--- a/src/test/java/org/jsoup/select/SelectorTest.java
+++ b/src/test/java/org/jsoup/select/SelectorTest.java
@@ -1613,6 +1613,23 @@ public class SelectorTest {
         assertEquals("a0b", Selector.escapeCssIdentifier("a0b"));
     }
 
+    @Test void escapedTrailingSpaceInIdentifier() {
+        // an escaped trailing space is part of the identifier and must survive query trimming
+        Element div = new Element("div");
+        div.appendElement("p").attr("id", "a ");
+        div.appendElement("p").attr("id", "a");
+
+        String query = "#" + Selector.escapeCssIdentifier("a ");
+        assertEquals("#a\\ ", query);
+        Elements els = Selector.select(query, div);
+        assertEquals(1, els.size());
+        assertEquals("a ", els.first().id());
+
+        assertEquals(1, Selector.select("  #a\\   ", div).size()); // unescaped whitespace around the query is still trimmed
+        assertEquals("a ", Selector.select("  #a\\   ", div).first().id());
+        assertEquals("a", Selector.select("  #a  ", div).first().id());
+    }
+
     @Test void unescapeCssIdentifier() {
         // thorough tests are in TokenQueue
         assertEquals("-0a", Selector.unescapeCssIdentifier("-\\30 a"));
